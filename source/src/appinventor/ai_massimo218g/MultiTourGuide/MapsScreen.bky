  <block type="global_declaration" id="LIne_%O.5cJ-tv7D]Oze" x="-951" y="120">
    <field name="NAME">KStText</field>
    <value name="VALUE">
      <block type="lists_create_with" id="1}j2c[FMMWEB2M`m;xud">
        <mutation items="4"></mutation>
        <value name="ADD0">
          <block type="text" id=".|2_Y-4UKv+nT7Mt,R8X">
            <field name="TEXT">Nu,  ki takuo niesmo same, videmo še kakega človieka</field>
          </block>
        </value>
        <value name="ADD1">
          <block type="text" id="*)*kq~fEMVS5uk**$=Fr">
            <field name="TEXT">Su che così non siamo sole, vediamo almeno un po’ di gente</field>
          </block>
        </value>
        <value name="ADD2">
          <block type="text" id="+VK{}+D69D9f{P.:/{ML">
            <field name="TEXT">So we are not alone, we see at least a few people</field>
          </block>
        </value>
        <value name="ADD3">
          <block type="text" id="P!/YH[TRR1[ipAx!ZvwX">
            <field name="TEXT">Wir sind also nicht allein, wir sehen zumindest ein paar Leute</field>
          </block>
        </value>
      </block>
    </value>
  </block>
  <block type="global_declaration" id="fLZ9_W.50j.#B.^^zDDX" x="-957" y="243">
    <field name="NAME">InstructionText</field>
    <value name="VALUE">
      <block type="lists_create_with" id="2i5%d#MlP1Zo)O`el.@D">
        <mutation items="4"></mutation>
        <value name="ADD0">
          <block type="text" id="L@akZx%)u]eL!siW=_D!">
            <field name="TEXT">Za informacije kliknite oznako. Dolgo kliknite za več podrobnosti o lokaciji.</field>
          </block>
