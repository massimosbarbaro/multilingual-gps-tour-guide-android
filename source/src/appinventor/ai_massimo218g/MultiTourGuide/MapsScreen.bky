  <block type="global_declaration" id=".,E6aW^?r9);.[#egU=a" x="-921" y="-534">
    <field name="NAME">KAText</field>
    <value name="VALUE">
      <block type="lists_create_with" id="XQ)3;`]m@9AV8Vuz!J7p">
        <mutation items="4"></mutation>
        <value name="ADD0">
          <block type="text" id="k+^t+ra|+avEf9QCRAq0">
            <field name="TEXT"> An tle na manjkajo ljudje, ki hodejo gledat slap Kot</field>
          </block>
        </value>
        <value name="ADD1">
          <block type="text" id="hdxZ]RTmERb+2CB(+3D9">
            <field name="TEXT">Anche qui non manca la gente che viene a vedere le cascate di Coot</field>
          </block>
        </value>
        <value name="ADD2">
          <block type="text" id="lhis#wN5gMsq/]w0gRV8">
            <field name="TEXT">Here, too, there is no lack of people who come to see Coot Falls</field>
          </block>
        </value>
        <value name="ADD3">
          <block type="text" id="l2u+RrdqO7;h2@o5~R=i">
            <field name="TEXT">Auch hier mangelt es nicht an Menschen, die zu Coot Falls kommen</field>
          </block>
        </value>
      </block>
    </value>
  </block>
  <block type="global_declaration" id="3E[._`gY/NSr7C+wl[NR" x="-927" y="-397">
    <field name="NAME">KIText</field>
    <value name="VALUE">
      <block type="lists_create_with" id="=SY5c[w%D~7sQ/[;mHtu">
        <mutation items="4"></mutation>
        <value name="ADD0">
          <block type="text" id="Ill|tx2JrCkyeytZiaJJ">
            <field name="TEXT">Takuo me kličejo zaki te pravo  ime Landarja  je svet Ivan gu čele.</field>
          </block>
        </value>
        <value name="ADD1">
          <block type="text" id="j$x?d.OwJX%Vg!vBjqz!">
            <field name="TEXT">Mi chiamano così perché Antro si chiama San Giovanni d’Antro… Giovanni  x noi è Ivan.</field>
          </block>
        </value>
        <value name="ADD2">
          <block type="text" id="][ph;0|vq/%qWEQ,[2S4">
            <field name="TEXT">They call me that because Antro is called San Giovanni d'Antro ... Giovanni x us is Ivan.</field>
          </block>
        </value>
        <value name="ADD3">
          <block type="text" id="n!QL,U#$GdAS%KRD*#Sd">
            <field name="TEXT">Sie nennen mich so, weil Antro San Giovanni d'Antro heißt ... Giovanni x us ist Ivan.</field>
          </block>
        </value>
      </block>
    </value>
  </block>
  <block type="global_declaration" id="4#J$M3co-@.9a_7USF2@" x="-934" y="-274">
    <field name="NAME">KMText</field>
    <value name="VALUE">
      <block type="lists_create_with" id="mCZaei5wUmc.Px`O`VW+">
        <mutation items="4"></mutation>
        <value name="ADD0">
          <block type="text" id="ibrVTi}{^Z(Eh,m08J5w">
            <field name="TEXT">…san, živim gor na Velik Bab, ku ki so pravli naši te stari. </field>
          </block>
        </value>
        <value name="ADD1">
          <block type="text" id="#}t;A)(ap]+rV?n|R3@G">
            <field name="TEXT">Vivo qui sulla Velika Baba, la grande Madre come la chiamavano i vecchi abitanti.</field>
          </block>
        </value>
        <value name="ADD2">
          <block type="text" id="zvd1=UOy766UpENY`bml">
            <field name="TEXT">I live here on Velika Baba, the great Mother as the old inhabitants called her.</field>
          </block>
        </value>
        <value name="ADD3">
          <block type="text" id="-Jom7kiH#}xk#L9FKYhb">
            <field name="TEXT">Ich lebe hier auf Velika Baba, der großen Mutter, wie die alten Bewohner sie nannten.</field>
          </block>
        </value>
      </block>
    </value>
  </block>
  <block type="global_declaration" id="F^i%7vmUp#_}F4OQi,i9" x="-938" y="-148">
    <field name="NAME">KRText</field>
    <value name="VALUE">
      <block type="lists_create_with" id="~UJodz=e*i}4(#|u;/+}">
        <mutation items="4"></mutation>
        <value name="ADD0">
          <block type="text" id="Ndk*@R6+,NrjDT/^S[2D">
            <field name="TEXT">San šele tle v Rečanski dolin</field>
          </block>
        </value>
        <value name="ADD1">
          <block type="text" id="0/VEKx`s:!0/){-!m3GD">
            <field name="TEXT">Abito ancora qui nella valle dell’Erbezzo</field>
          </block>
        </value>
        <value name="ADD2">
          <block type="text" id="NU(m91Jbx71SeU8MGHVw">
            <field name="TEXT">I still live here in the Erbezzo valley</field>
          </block>
        </value>
        <value name="ADD3">
          <block type="text" id="E`J$7FkQqfY,W`Qzl{}c">
            <field name="TEXT">Ich lebe immer noch hier im Erbezzo-Tal</field>
          </block>
        </value>
      </block>
    </value>
  </block>
