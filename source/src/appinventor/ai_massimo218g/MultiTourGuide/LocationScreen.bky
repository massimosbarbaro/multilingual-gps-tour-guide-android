        <value name="ADD0">
          <block type="text" id="MzsfDPG]k=Fnf`y?tr8,">
            <field name="TEXT">Sarzenska.jpg</field>
          </block>
        </value>
        <value name="ADD1">
          <block type="text" id="~x?I?X6Lj0r2{~TnE6rO">
            <field name="TEXT">Ivanka.jpg</field>
          </block>
