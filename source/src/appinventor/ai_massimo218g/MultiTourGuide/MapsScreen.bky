  <block type="global_declaration" id="-Ed%U%gh9^0_.+L2%yNS" x="-947" y="-12">
    <field name="NAME">KSaText</field>
    <value name="VALUE">
      <block type="lists_create_with" id="Ums7l_KJ}}GG^MB:+}R4">
        <mutation items="4"></mutation>
        <value name="ADD0">
          <block type="text" id="OJc6P7-y]e4HX^.oM}`N">
            <field name="TEXT">Duo me na pozna, gor za Makotah, gu Tarnjah, ta pod skalah,  smo živiele</field>
          </block>
        </value>
        <value name="ADD1">
          <block type="text" id="etCPOeI.uRW6+~p_JwS7">
            <field name="TEXT">Chi non mi conosce,  Su dietro a Makota, a Tarnje sotto le rocce vivevamo</field>
          </block>
        </value>
        <value name="ADD2">
          <block type="text" id="V}sJBU9$T`IL6ejfJ2vj">
            <field name="TEXT">Who does not know me, Up behind Makota, in Tarnje we lived under the rocks</field>
          </block>
        </value>
        <value name="ADD3">
          <block type="text" id="%ud{1AS^vjXl=03q8*Mu">
            <field name="TEXT">Wer kennt mich nicht? Oben hinter Makota lebten wir in Tarnje unter den Felsen</field>
          </block>
        </value>
      </block>
    </value>
  </block>
